{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "data-governance",
  "version": "2.0.0",
  "description": "数据治理插件：元数据查询 + 六性质检规则生成 + SQL转换 + 检查执行 + 质量报告",
  "author": {
    "name": "matrix4033"
  },
  "skills": ["./plugin/skills/dg-query", "./plugin/skills/dg-rules", "./plugin/skills/dg-convert", "./plugin/skills/dg-run", "./plugin/skills/dg-report"],
"userConfig": {
    "NEO4J_HOST": {
      "type": "string",
      "title": "Neo4j 主机地址",
      "description": "Neo4j 数据库主机地址",
      "default": "127.0.0.1"
    },
    "NEO4J_PORT": {
      "type": "string",
      "title": "Neo4j 端口",
      "description": "Neo4j 数据库端口",
      "default": "7687"
    },
    "NEO4J_USER": {
      "type": "string",
      "title": "Neo4j 用户名",
      "description": "Neo4j 用户名",
      "default": "neo4j"
    },
    "NEO4J_PASSWORD": {
      "type": "string",
      "title": "Neo4j 密码",
      "description": "Neo4j 密码",
      "sensitive": true,
      "default": ""
    },
    "NEO4J_DATABASE": {
      "type": "string",
      "title": "Neo4j 数据库名",
      "description": "Neo4j 数据库名",
      "default": "neo4j"
    }
  }
}
