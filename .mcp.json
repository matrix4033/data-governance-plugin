{
  "mcpServers": {
    "dg-neo4j": {
      "type": "stdio",
      "command": "bash",
      "args": ["plugin/scripts/mcp_wrapper.sh", "mcp_neo4j.py"],
      "env": {
        "NEO4J_HOST": "127.0.0.1",
        "NEO4J_PORT": "7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_DATABASE": "neo4j"
      }
    },
    "dg-builder": {
      "type": "stdio",
      "command": "bash",
      "args": ["plugin/scripts/mcp_wrapper.sh", "mcp_builder.py"],
      "env": {
        "BUILDER_CONFIG": "plugin/scripts/config.json",
        "BUILDER_DIR": "plugin/scripts/builder"
      }
    }
  }
}
