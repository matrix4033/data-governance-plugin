{
  "mcpServers": {
    "dg-neo4j": {
      "command": "/opt/anaconda3/envs/work-env/bin/python",
      "args": [
        "${CLAUDE_PLUGIN_DIR}/scripts/mcp_neo4j.py"
      ],
      "env": {
        "NEO4J_HOST": "${neo4j_host:127.0.0.1}",
        "NEO4J_PORT": "${neo4j_port:7687}",
        "NEO4J_USER": "${neo4j_user:neo4j}",
        "NEO4J_PASSWORD": "${neo4j_password}",
        "NEO4J_DATABASE": "${neo4j_database:neo4j}"
      }
    },
    "dg-builder": {
      "command": "/opt/anaconda3/envs/work-env/bin/python",
      "args": [
        "${CLAUDE_PLUGIN_DIR}/scripts/mcp_builder.py"
      ],
      "env": {
        "BUILDER_CONFIG": "${CLAUDE_PLUGIN_DIR}/scripts/config.json",
        "BUILDER_DIR": "${CLAUDE_PLUGIN_DIR}/scripts/builder"
      }
    }
  }
}
